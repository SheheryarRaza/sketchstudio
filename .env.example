# ==========================================
# Sketch Studio Atelier - Environment Config
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_USER=sketch_user
POSTGRES_PASSWORD=sketch_secure_password_change_me
POSTGRES_DB=sketch_studio
POSTGRES_PORT=5432

# Backend FastAPI Configuration
DATABASE_URL=postgresql+psycopg://sketch_user:sketch_secure_password_change_me@postgres:5432/sketch_studio
DEBUG=false
UPLOAD_DIR=/app/uploads

# Frontend Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
# Backend address as seen from inside the frontend container (Docker service DNS name)
BACKEND_INTERNAL_URL=http://backend:8000
PORT=3000
